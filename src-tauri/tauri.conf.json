{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOONDROP Hub Desktop",
  "version": "1.6.5",
  "identifier": "com.moondroplab.hub.desktop",
  "build": {
    "beforeBuildCommand": "npm run prepare-frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MOONDROP Hub Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      },
      {
        "label": "tray",
        "title": "MOONDROP Switch",
        "url": "tray.html",
        "width": 340,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
